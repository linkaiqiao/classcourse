<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 顶部状态栏模拟（固定高度24dp） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:orientation="horizontal"
        android:background="#6200EE"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

    </LinearLayout>

    <!-- 周次和学期信息（固定高度）- 修改为RelativeLayout添加设置按钮 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#6200EE"
        android:paddingLeft="16dp"
        android:paddingTop="12dp">

        <!-- 周次和学期信息容器 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tvWeekInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="第18周"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSemesterInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025-2026\n第1学期"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- 设置按钮 - 放在顶部紫色栏的右侧（您的红框位置） -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="设置"
            app:tint="#FFFFFF" />

    </RelativeLayout>

    <!-- 添加课程按钮（悬浮按钮） -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingTop="12dp">

        <ImageButton
            android:id="@+id/btnAddCourse"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:background="@drawable/circle_background"
            android:src="@drawable/ic_add"
            android:elevation="8dp"
            android:contentDescription="添加课程"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvCurrentScheduleName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="默认课表"
            android:textSize="16sp"
            android:textColor="#6200EE"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="200dp" />

        <ImageButton
            android:id="@+id/btnScheduleManagement"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:background="@drawable/circle_background"
            android:src="@drawable/ic_schedule"
            android:elevation="8dp"
            android:contentDescription="课表管理"
            app:tint="#FFFFFF" />

    </RelativeLayout>

    <!-- 周数导航控件 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F3E5F5"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnPrevWeek"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="上一周"
            app:tint="#6200EE" />

        <Button
            android:id="@+id/btnCurrentWeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:text="回到本周"
            android:textColor="#6200EE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:contentDescription="回到本周" />

        <ImageButton
            android:id="@+id/btnNextWeek"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_media_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="下一周"
            app:tint="#6200EE" />

    </LinearLayout>

    <!-- 课程表标题行（固定高度） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="#F5F5F5">

        <!-- 时间标题单元格（固定宽度80dp） -->
        <TextView
            android:id="@+id/tvTimeTitle"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:text="时间"
            android:textSize="14sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#F5F5F5" />

        <!-- 星期标题容器，使用水平滚动 -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/llWeekdayHeaders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- 星期标题将在代码中动态设置 -->
                <TextView
                    android:id="@+id/tvMonday"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="周一\n--"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tvTuesday"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="周二\n--"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tvWednesday"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="周三\n--"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tvThursday"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="周四\n--"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tvFriday"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="周五\n--"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:lineSpacingExtra="2dp" />

                <!-- 可以添加更多天数 -->
                <TextView
                    android:id="@+id/tvSaturday"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="周六\n--"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tvSunday"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="周日\n--"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#F5F5F5"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 课程表格主容器（可垂直和水平滚动） -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:background="#FFFFFF">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF">

                <!-- 表格行容器（代码中动态添加） -->
                <LinearLayout
                    android:id="@+id/llCourseTableContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 课程表格内容将由代码动态生成 -->

                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>
    </ScrollView>

    <!-- 底部导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center">

        <!-- 课程表 -->
        <LinearLayout
            android:id="@+id/nav_schedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_schedule_nav"
                app:tint="#6200EE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="课程表"
                android:textSize="12sp"
                android:textColor="#6200EE"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 消息 -->
        <LinearLayout
            android:id="@+id/nav_message"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_message"
                app:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="消息"
                android:textSize="12sp"
                android:textColor="#666666" />

        </LinearLayout>

        <!-- 我的 -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_profile"
                app:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的"
                android:textSize="12sp"
                android:textColor="#666666" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>